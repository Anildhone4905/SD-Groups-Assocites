<!-- ================= JAVASCRIPT ================= -->

<script>

function sendWhatsApp(message){

    const phone = "919370460237";

    const url =
    "https://wa.me/" +
    phone +
    "?text=" +
    encodeURIComponent(message);

    window.open(url, "_blank");

}


function sendCustomWhatsApp(){

    const name =
    document.getElementById("customerName").value;

    const mobile =
    document.getElementById("customerMobile").value;

    const message =
    document.getElementById("customerMessage").value;

    if(name === "" || message === ""){

        alert("Please enter your Name and Requirement.");

        return;

    }

    const finalMessage =
    "Hello SD Groups & Associates,%0A%0A" +
    "Name: " + name + "%0A" +
    "Mobile: " + mobile + "%0A" +
    "Requirement: " + message;

    window.open(
        "https://wa.me/919370460237?text=" +
        encodeURIComponent(
            "Hello SD Groups & Associates,\n\n" +
            "Name: " + name + "\n" +
            "Mobile: " + mobile + "\n" +
            "Requirement: " + message
        ),
        "_blank"
    );

}

</script>

