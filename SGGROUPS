<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>SD Groups & Associates | Jalna</title>

  <meta name="description"
        content="SD Groups & Associates Jalna - Accounting, Taxation, GST, ITR, Audit, Loan and Business Registration Services.">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: #263449;
      line-height: 1.6;
      background: #ffffff;
    }

    a {
      text-decoration: none;
    }

    .container {
      width: 92%;
      max-width: 1150px;
      margin: auto;
    }

    /* HEADER */

    header {
      background: white;
      box-shadow: 0 2px 15px rgba(0,0,0,0.10);
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .navbar {
      min-height: 75px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      color: #0b3d91;
      font-size: 22px;
      font-weight: bold;
    }

    .logo small {
      display: block;
      color: #777;
      font-size: 11px;
      letter-spacing: 1px;
    }

    nav a {
      color: #10233f;
      margin-left: 25px;
      font-weight: bold;
    }

    nav a:hover {
      color: #0b3d91;
    }

    .menu {
      display: none;
      font-size: 28px;
      cursor: pointer;
    }

    /* HERO */

    .hero {
      background: linear-gradient(135deg, #0b3d91, #10233f);
      color: white;
      padding: 90px 0;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.3fr 0.7fr;
      gap: 45px;
      align-items: center;
    }

    .hero h5 {
      color: #f4b400;
      font-size: 16px;
      letter-spacing: 1px;
    }

    .hero h1 {
      font-size: 50px;
      line-height: 1.1;
      margin: 15px 0;
    }

    .hero h1 span {
      color: #f4b400;
    }

    .hero p {
      font-size: 18px;
      color: #e7efff;
      margin-bottom: 25px;
    }

    .btn {
      display: inline-block;
      padding: 13px 22px;
      border-radius: 8px;
      font-weight: bold;
      margin: 5px;
    }

    .btn-primary {
      background: #f4b400;
      color: #111;
    }

    .btn-white {
      background: white;
      color: #0b3d91;
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .hero-card {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.25);
      padding: 28px;
      border-radius: 18px;
    }

    .hero-card h3 {
      margin-bottom: 15px;
    }

    .hero-card li {
      list-style: none;
      padding: 9px 0;
      border-bottom: 1px solid rgba(255,255,255,0.15);
    }

    /* SECTION */

    section {
      padding: 75px 0;
    }

    .section-title {
      text-align: center;
      margin-bottom: 45px;
    }

    .section-title h2 {
      font-size: 35px;
      color: #10233f;
    }

    .section-title p {
      color: #667085;
      margin-top: 8px;
    }

    /* SERVICES */

    .services {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 23px;
    }

    .service-card {
      padding: 28px;
      border: 1px solid #e3e8f0;
      border-radius: 15px;
      box-shadow: 0 8px 25px rgba(16,35,63,0.07);
      background: white;
      transition: 0.3s;
    }

    .service-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 30px rgba(16,35,63,0.12);
    }

    .service-icon {
      font-size: 35px;
    }

    .service-card h3 {
      color: #0b3d91;
      margin: 10px 0;
    }

    /* ABOUT */

    .about {
      background: #f5f8fc;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 45px;
      align-items: center;
    }

    .about h2 {
      font-size: 35px;
      color: #10233f;
      margin-bottom: 15px;
    }

    .about-list li {
      list-style: none;
      padding: 9px 0;
    }

    .about-list li::before {
      content: "✓";
      color: green;
      font-weight: bold;
      margin-right: 10px;
    }

    .about-box {
      background: white;
      padding: 30px;
      border-radius: 15px;
      box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    }

    .about-box h3 {
      color: #0b3d91;
      margin-bottom: 10px;
    }

    /* PROCESS */

    .process {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 25px;
    }

    .process-card {
      text-align: center;
      padding: 30px;
      border: 1px solid #e4e8ef;
      border-radius: 15px;
    }

    .process-number {
      width: 50px;
      height: 50px;
      background: #0b3d91;
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: auto;
      font-weight: bold;
      font-size: 18px;
    }

    .process-card h3 {
      margin: 15px 0 8px;
      color: #10233f;
    }

    /* CONTACT */

    .contact {
      background: #10233f;
      color: white;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 45px;
    }

    .contact h2 {
      font-size: 35px;
      margin-bottom: 15px;
    }

    .contact p {
      color: #dce5f5;
      margin: 8px 0;
    }

    .contact-box {
      background: rgba(255,255,255,0.08);
      padding: 28px;
      border-radius: 15px;
      border: 1px solid rgba(255,255,255,0.15);
    }

    .contact-box a {
      display: block;
      color: white;
      margin: 15px 0;
      font-size: 17px;
    }

    .contact-box a:hover {
      color: #f4b400;
    }

    /* WHATSAPP */

    .whatsapp {
      position: fixed;
      right: 20px;
      bottom: 20px;
      background: #25D366;
      color: white;
      padding: 14px 20px;
      border-radius: 50px;
      font-weight: bold;
      box-shadow: 0 8px 20px rgba(0,0,0,0.25);
      z-index: 2000;
    }

    /* FOOTER */

    footer {
      background: #08172b;
      color: #b9c5d8;
      text-align: center;
      padding: 25px;
    }

    footer p {
      margin: 5px;
    }

    /* MOBILE */

    @media(max-width:800px) {

      .menu {
        display: block;
      }

      nav {
        display: none;
        position: absolute;
        top: 75px;
        left: 0;
        right: 0;
        background: white;
        padding: 15px 5%;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
      }

      nav.active {
        display: block;
      }

      nav a {
        display: block;
        margin: 15px 0;
      }

      .hero-grid,
