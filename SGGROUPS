        width:100%;
        padding:20px;
    }

    .header{
        padding:0 15px;
    }

    .header-right{
        display:none;
    }

    .cards,
    .service-grid,
    .documents{
        grid-template-columns:1fr;
    }

    .whatsapp-form{
        grid-template-columns:1fr;
    }

    .whatsapp-form textarea,
    .whatsapp-form button{
        grid-column:auto;
    }

}

</style>
