<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#f4f7fb;
    color:#263449;
}

/* ================= HEADER ================= */

.header{
    height:72px;
    background:#0b3d91;
    color:white;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 30px;
    position:sticky;
    top:0;
    z-index:1000;
    box-shadow:0 3px 15px #0003;
}

.logo{
    font-size:21px;
    font-weight:bold;
}

.logo span{
    display:block;
    font-size:11px;
    color:#dbe7ff;
    margin-top:2px;
}

.header-right{
    display:flex;
    align-items:center;
    gap:15px;
}

.call-btn{
    background:#25d366;
    color:white;
    padding:10px 18px;
    border-radius:7px;
    text-decoration:none;
    font-weight:bold;
}

/* ================= LAYOUT ================= */

.layout{
    display:flex;
    min-height:calc(100vh - 72px);
}

/* ================= SIDEBAR ================= */

.sidebar{
    width:250px;
    background:#10233f;
    color:white;
    padding:22px 15px;
    position:fixed;
    top:72px;
    bottom:0;
    overflow-y:auto;
}

.sidebar h4{
    color:#8fb3ff;
    font-size:12px;
    text-transform:uppercase;
    margin:18px 12px 8px;
}

.sidebar a{
    display:block;
    color:#dbe5f5;
    text-decoration:none;
    padding:12px 14px;
    margin:3px 0;
    border-radius:7px;
    transition:.2s;
}

.sidebar a:hover{
    background:#0b3d91;
    color:white;
}

/* ================= MAIN ================= */

.main{
    margin-left:250px;
    width:calc(100% - 250px);
    padding:30px;
}

.page-title{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:25px;
}

.page-title h1{
    color:#10233f;
    font-size:30px;
}

.page-title p{
    color:#667085;
}

/* ================= CARDS ================= */

.cards{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
    margin-bottom:30px;
}

.card{
    background:white;
    padding:22px;
    border-radius:12px;
    border:1px solid #e2e8f0;
    box-shadow:0 5px 20px #10233f0b;
}

.card-icon{
    font-size:30px;
    margin-bottom:10px;
}

.card h3{
    color:#10233f;
    margin-bottom:5px;
}

.card p{
    color:#667085;
    font-size:14px;
}

.card a{
    display:inline-block;
    margin-top:14px;
    color:#0b3d91;
    font-weight:bold;
    text-decoration:none;
}

/* ================= SERVICE GRID ================= */

.section-title{
    margin:35px 0 18px;
}

.section-title h2{
    color:#10233f;
}

.service-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.service{
    background:white;
    border:1px solid #e2e8f0;
    padding:23px;
    border-radius:12px;
    transition:.25s;
}

.service:hover{
    transform:translateY(-4px);
    box-shadow:0 8px 25px #10233f18;
}

.service .icon{
    font-size:35px;
}

.service h3{
    color:#0b3d91;
    margin:10px 0;
}

.service p{
    font-size:14px;
    color:#667085;
}

.service button{
    border:0;
    background:#0b3d91;
    color:white;
    padding:9px 15px;
    border-radius:6px;
    margin-top:15px;
    cursor:pointer;
}

/* ================= WHATSAPP ================= */

.whatsapp-section{
    background:#eafff1;
    border:1px solid #bde8cb;
    padding:25px;
    border-radius:12px;
    margin-top:25px;
}

.whatsapp-section h2{
    color:#137333;
    margin-bottom:8px;
}

.whatsapp-form{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
    margin-top:15px;
}

.whatsapp-form input,
.whatsapp-form textarea{
    width:100%;
    padding:13px;
    border:1px solid #ccd5df;
    border-radius:7px;
    font-family:inherit;
}

.whatsapp-form textarea{
    grid-column:1 / -1;
    min-height:100px;
}

.whatsapp-form button{
    grid-column:1 / -1;
    background:#25d366;
    color:white;
    border:0;
    padding:13px;
    border-radius:7px;
    font-weight:bold;
    cursor:pointer;
}

/* ================= DOCUMENTS ================= */

.documents{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:18px;
}

.document-box{
    background:white;
    padding:22px;
    border-radius:12px;
    border:1px solid #e2e8f0;
}

.document-box h3{
    color:#0b3d91;
    margin-bottom:12px;
}

.document-box li{
    list-style:none;
    padding:7px 0;
    border-bottom:1px solid #edf0f4;
}

.document-box li::before{
    content:"✓";
    color:green;
    font-weight:bold;
    margin-right:8px;
}

/* ================= CONTACT ================= */

.contact{
    margin-top:30px;
    background:#10233f;
    color:white;
    padding:30px;
    border-radius:12px;
}

.contact h2{
    margin-bottom:10px;
}

.contact p{
    color:#dce5f5;
    margin:6px 0;
}

.contact a{
    color:#f4b400;
}

/* ================= FOOTER ================= */

.footer{
    text-align:center;
    padding:25px;
    color:#667085;
    margin-top:30px;
}

/* ================= FLOATING WHATSAPP ================= */

.float-whatsapp{
    position:fixed;
    right:22px;
    bottom:22px;
    background:#25d366;
    color:white;
    padding:15px 20px;
    border-radius:50px;
    font-weight:bold;
    text-decoration:none;
    box-shadow:0 6px 20px #0003;
    z-index:2000;
}

/* ================= RESPONSIVE ================= */

@media(max-width:1100px){

    .cards{
        grid-template-columns:repeat(2,1fr);
    }

    .service-grid{
        grid-template-columns:repeat(2,1fr);
    }

}

@media(max-width:800px){

    .sidebar{
        display:none;
    }

    .main{
